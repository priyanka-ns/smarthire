# Copy to .env (or set these in your host's dashboard). Never commit real keys.

# Required: your Anthropic API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the Claude model (default: claude-opus-4-6)
# CLAUDE_MODEL=claude-sonnet-4-6

# Optional: restrict which origins may call the API (default: * )
# Set this to your GitHub Pages URL in production, e.g.:
# CORS_ALLOWED_ORIGINS=https://priyanka-ns.github.io

# Optional: port (hosts like Render/Railway set this automatically)
# PORT=8080
